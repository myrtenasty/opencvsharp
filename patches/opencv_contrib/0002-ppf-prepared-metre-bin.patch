+static void validatePreparedPoints(const Mat& points, double distanceBinMetres)
+{
+  CV_CheckTypeEQ(points.type(), CV_32FC1, "Prepared points must be CV_32FC1");
+  CV_Assert(points.dims == 2 && points.cols == 6 && points.rows >= 2);
+  CV_Assert(std::isfinite(distanceBinMetres) && distanceBinMetres > 0);
+  Vec3d low = Vec3d::all(std::numeric_limits<double>::max());
+  Vec3d high = Vec3d::all(-std::numeric_limits<double>::max());
+  for (int i = 0; i < points.rows; ++i)
+  {
+    const float* row = points.ptr<float>(i);
+    for (int j = 0; j < 6; ++j)
+      CV_Assert(std::isfinite(row[j]));
+    for (int j = 0; j < 3; ++j)
+    {
+      low[j] = std::min(low[j], static_cast<double>(row[j]));
+      high[j] = std::max(high[j], static_cast<double>(row[j]));
+    }
+    const Vec3d normal(row[3], row[4], row[5]);
+    CV_Assert(std::abs(normal.dot(normal) - 1.0) <= 1e-4);
+  }
+  // hashPPF converts the distance quotient to int. Reject an unsafe bin
+  // explicitly rather than overflowing or silently substituting a larger bin.
+  CV_Assert(norm(high - low) / distanceBinMetres < std::numeric_limits<int>::max());
+}
+
+void PPF3DDetector::trainPrepared(InputArray modelPoints, double distanceBinMetres, double numberOfAngles)
+{
+  const Mat points = modelPoints.getMat();
+  validatePreparedPoints(points, distanceBinMetres);
+  CV_Assert(std::isfinite(numberOfAngles) && numberOfAngles >= 1);
+  CV_Assert(numberOfAngles < std::numeric_limits<int>::max());
+  CV_Assert(static_cast<int64_t>(points.rows) * points.rows <= std::numeric_limits<int>::max());
+  CV_Assert(numberOfAngles * points.rows <= std::numeric_limits<int>::max());
+  // Own the exact rows, including separate normal groups at coincident points.
+  Mat ownedPoints = points.clone();
+  angle_step_radians = 2 * M_PI / numberOfAngles;
+  trainPoints(ownedPoints, distanceBinMetres, true);
+  prepared_training = true;
+}
