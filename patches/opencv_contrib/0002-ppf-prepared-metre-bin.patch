+void PPF3DDetector::matchPrepared(InputArray scenePoints, std::vector<Pose3DPtr>& results,
+                                  double sceneReferenceFraction, double distanceBinMetres)
+{
+  const Mat points = scenePoints.getMat();
+  validatePreparedPoints(points, distanceBinMetres);
+  CV_Assert(std::isfinite(sceneReferenceFraction) &&
+            sceneReferenceFraction > 0 && sceneReferenceFraction <= 1);
+  if (!trained || !prepared_training)
+    CV_Error(Error::StsError, "Call trainPrepared before matchPrepared");
+  if (distanceBinMetres != distance_step)
+    CV_Error(Error::StsBadArg, "distanceBinMetres must equal the training bin in metres");
+  // Clamp before conversion so tiny positive fractions remain well-defined.
+  const int stride = static_cast<int>(std::min(1.0 / sceneReferenceFraction,
+                                               static_cast<double>(points.rows)));
+  matchPoints(points, results, stride, true);
+}
